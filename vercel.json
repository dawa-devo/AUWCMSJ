{
    "installCommand": "npm --prefix backend ci",
    "buildCommand": "npm --prefix backend run build",
    "outputDirectory": ".",
    "headers": [
        {
            "source": "/(.*)\\.(css|js|mjs|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=86400"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/admin",
            "destination": "/admin/",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/api/:first/:rest*",
            "destination": "/api/index?__api_path=:first/:rest*"
        },
        {
            "source": "/register.html",
            "destination": "/frontend/register.html"
        },
        {
            "source": "/login.html",
            "destination": "/frontend/login.html"
        },
        {
            "source": "/userdashboard.html",
            "destination": "/frontend/userdashboard.html"
        },
        {
            "source": "/skill.html",
            "destination": "/frontend/skill.html"
        },
        {
            "source": "/fcontact.html",
            "destination": "/frontend/fcontact.html"
        },
        {
            "source": "/admin/",
            "destination": "/admin/admin.html"
        }
    ]
}