PUBLIC_APP_URL=http://127.0.0.1:5500
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_PASSWORD_FALLBACK=false
EMAIL_USER=
EMAIL_PASS=
NODE_ENV=development
