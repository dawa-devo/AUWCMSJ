PORT=5000
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/auwcmsj
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
# Set these from the Cloudinary dashboard; the API secret must remain server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
